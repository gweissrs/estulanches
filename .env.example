# ===== EstuLanches - modelo de variáveis de ambiente =====
# Copie para .env e preencha:  cp .env.example .env
# Nunca versione o arquivo .env.

# Banco de dados (PostgreSQL)
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=estulanches

# Aplicação
APP_VERSION=1.0.0
APP_PORT=3000
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_com_no_minimo_32_caracteres
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
# Origens autorizadas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Administrador inicial (criado pelo seed na primeira inicialização)
ADMIN_NAME=Administrador da Cantina
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque_esta_senha_123
